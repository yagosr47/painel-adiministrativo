{
  "name": "painel-administrativo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Painel administrativo para desenvolvimento e gerenciamento de sites: templates por segmento, biblioteca de imagens e personalizacao isolada por cliente.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p client/tsconfig.json --noEmit && vite build",
    "start": "npm run build && node server/index.js",
    "seed": "node server/seed/run.js --force",
    "test": "node --test --test-timeout=30000 server/tests/*.test.js",
    "serve": "node server/index.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "esbuild": "^0.25.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
